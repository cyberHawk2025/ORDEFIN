{
  "name": "ordefin",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "desktop:start": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env FINORA_DEV_SERVER=1 electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --dir",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "check:release": "node scripts/check-release.mjs",
    "check:types": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:electron": "node scripts/test-electron.cjs",
    "test:live": "node scripts/check-live-sources.mjs",
    "check": "npm run check:types && npm run check:electron && npm test && npm run build && npm run check:release"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "oxfmt": "^0.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wait-on": "^8.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.ordefin.financeiro",
    "productName": "ORDEFIN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "shared/**/*",
      "services/**/*",
      "build/*.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/programa.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORDEFIN",
      "language": "1046",
      "runAfterFinish": true,
      "uninstallDisplayName": "ORDEFIN",
      "installerIcon": "build/instalador.ico",
      "uninstallerIcon": "build/instalador.ico",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "ORDEFIN-Setup-${version}-${arch}.${ext}"
  },
  "description": "Controle financeiro pessoal ORDEFIN",
  "author": "ORDEFIN"
}
